EWELINK_APP_ID=
EWELINK_APP_SECRET=
# The postgres instance from docker-compose.yml
DATABASE_URL=postgres://sensors:sensors@localhost:5432/sensors?sslmode=disable

# Heatmiser NeoHub (optional). Create a token in the Neo app: Settings > API > +
# Thermostats are only monitored when NEOHUB_TOKEN is set.
NEOHUB_HOST=Neo-Hub
NEOHUB_PORT=4243
NEOHUB_TOKEN=
NEOHUB_POLL_INTERVAL=1m
